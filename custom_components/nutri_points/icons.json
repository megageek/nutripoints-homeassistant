{
  "entity": {
    "binary_sensor": {
      "over_budget": {
        "default": "mdi:alert-circle"
      },
      "points_low": {
        "default": "mdi:alert-circle-outline"
      }
    },
    "sensor": {
      "activity_points": {
        "default": "mdi:run"
      },
      "budget_points": {
        "default": "mdi:target"
      },
      "food_points": {
        "default": "mdi:food-apple"
      },
      "remaining_points": {
        "default": "mdi:counter"
      },
      "total_drink_volume": {
        "default": "mdi:cup-water"
      }
    }
  },
  "triggers": {
    "food_logged": {
      "trigger": "mdi:food-apple"
    },
    "food_weighing_session_started": {
      "trigger": "mdi:scale"
    },
    "recipe_batch_label_requested": {
      "trigger": "mdi:label-outline"
    },
    "weigh_in_summary_generated": {
      "trigger": "mdi:scale-bathroom"
    }
  }
}
